{
  "version": "0.1.0",
  "tasks": {
    "dev": "deno run --allow-all npm:vite",
    "build": "deno run --allow-all npm:vite build",
    "preview": "deno run --allow-all npm:vite preview"
  },
  "imports": {
    "@/lib/supabase": "./src/lib/supabase.ts",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.6",
    "@types/react": "npm:@types/react@^18",
    "react": "npm:react@^18",
    "react/": "npm:react@^18/",
    "react/jsx-runtime": "npm:react@^18/jsx-runtime.js",
    "react-dom": "npm:react-dom@^18.3.1",
    "react-dom/": "npm:react-dom@^18/",
    "react-dom/client": "npm:react-dom@^18/client",
    "react-router-dom": "npm:react-router-dom@^6",
    "react-markdown": "npm:react-markdown@^9",
    "react-swipeable": "npm:react-swipeable@^7",
    "sonner": "npm:sonner@^2.0.7",
    "vite": "npm:vite@^5",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4",
    "vite-plugin-pwa": "npm:vite-plugin-pwa@^0.21",
    "workbox-window": "npm:workbox-window@^7",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
