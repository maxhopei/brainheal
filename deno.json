{
  "workspace": [
    "./packages/shared",
    "./frontend",
    "./worker",
    "./supabase/functions/ingest",
    "./supabase/functions/stripe-webhook"
  ],
  "nodeModulesDir": "auto",
  "imports": {
    "@brainheal/shared": "./packages/shared/mod.ts",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.6",
    "hono": "npm:hono@^4",
    "hono/": "npm:hono@^4/",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2",
    "react": "npm:react@^18",
    "react/": "npm:react@^18/",
    "react-dom": "npm:react-dom@^18",
    "react-dom/": "npm:react-dom@^18/",
    "react-router-dom": "npm:react-router-dom@^6",
    "react-markdown": "npm:react-markdown@^9",
    "react-swipeable": "npm:react-swipeable@^7",
    "vite": "npm:vite@^5",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4",
    "vite-plugin-pwa": "npm:vite-plugin-pwa@^0.21",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    "check": "deno check **/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "test": "deno test --allow-all",
    "start": "deno task supabase:start && deno task docker:start",
    "stop": "deno task docker:stop && deno task supabase:stop",
    "docker:start": "docker compose up -d --build",
    "docker:stop": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:migrate": "supabase db push",
    "fn:ingest": "supabase functions serve ingest --env-file supabase/functions/ingest/.env",
    "fn:stripe-webhook": "supabase functions serve stripe-webhook --env-file supabase/functions/stripe-webhook/.env",
    "deploy:fn:ingest": "supabase functions deploy ingest",
    "deploy:fn:stripe-webhook": "supabase functions deploy stripe-webhook --no-verify-jwt"
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve"
  }
}
