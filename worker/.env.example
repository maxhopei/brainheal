# Supabase — local dev (supabase start)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider — openai | anthropic | bedrock
LLM_PROVIDER=openai

# For openai or anthropic providers:
# LLM_API_KEY=<your-api-key>  # required — no default

# For bedrock provider (used instead of LLM_API_KEY):
# AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
# AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
# AWS_REGION=us-east-1

# Optional: model name override (provider-specific default used if not set)
# openai default:    gpt-4o-mini
# anthropic default: claude-3-5-haiku-20241022
# bedrock default:   anthropic.claude-3-5-haiku-20241022-v1:0
# LLM_MODEL=gpt-4o-mini

# Optional overrides
# POLL_INTERVAL_MS=5000
# HEALTH_PORT=8080
# FREE_MONTHLY_BUDGET_USD=1.00
# PAID_MONTHLY_BUDGET_USD=10.00
