# Supabase — local dev (supabase start)
# Ingested automatically by Supabase on `supbase functions serve <fn>`.
#SUPABASE_URL=http://localhost:54321
#SUPABASE_ANON_KEY=
#SUPABASE_SERVICE_ROLE_KEY=

# Ingestion mode: 'deferred' (uses worker) or 'immediate' (processes in Edge Function)
# Default: deferred
INGESTION_MODE=deferred

# LLM configuration (required for immediate mode)
# Provider: 'openai' | 'anthropic' | 'bedrock'
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# LLM API keys (required based on provider)
LLM_API_KEY=sk-your-api-key-here

# AWS credentials (required when LLM_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Budget configuration (optional — defaults shown)
FREE_MONTHLY_BUDGET_USD=1.00
PAID_MONTHLY_BUDGET_USD=10.00
